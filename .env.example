# Public Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PhonePe Standard Checkout v2 (server-only; never prefix these with VITE_)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=

# Configure this exact callback URL in the PhonePe merchant dashboard:
# https://yomora.in/api/phonepe-webhook

# Velocity Shipping custom API (server-only; never prefix these with VITE_)
VELOCITY_USERNAME=
VELOCITY_PASSWORD=
VELOCITY_PICKUP_LOCATION=
VELOCITY_WAREHOUSE_ID=
VELOCITY_STORE_NAME=
VELOCITY_WEBHOOK_API_KEY=
VELOCITY_PACKAGE_LENGTH_CM=15
VELOCITY_PACKAGE_BREADTH_CM=12
VELOCITY_PACKAGE_HEIGHT_CM=5
VELOCITY_PACKAGE_WEIGHT_KG=0.3

# Configure this endpoint in Velocity under Settings -> Webhooks.
# Select API Key authentication and use the same value as VELOCITY_WEBHOOK_API_KEY.
# https://yomora.in/api/velocity-webhook

